# uc-perf-tests — Configuration
# Copy to .env and fill in your values:
#   cp env.sample .env

# =============================================================================
# Databricks Connection (required)
# =============================================================================

DATABRICKS_PROFILE=""
DATABRICKS_CLUSTER_ID=""
WORKSPACE_DIR="/Workspace/Users/your-email/uc_perf_tests"

# =============================================================================
# Neo4j Aura Credentials (required)
# =============================================================================

# Neo4j host WITHOUT protocol prefix
# e.g., for "neo4j+s://example.databases.neo4j.io" use "example.databases.neo4j.io"
NEO4J_HOST="your-instance.databases.neo4j.io"
NEO4J_USERNAME="neo4j"
NEO4J_PASSWORD=""
NEO4J_DATABASE="neo4j"

# =============================================================================
# Unity Catalog JDBC Connection (required)
# =============================================================================

UC_CONNECTION_NAME="aircraft_connection_v2"
JDBC_JAR_PATH="/Volumes/<catalog>/<schema>/<volume>/neo4j-unity-catalog-connector.jar"

# =============================================================================
# Lakehouse Configuration (required for Delta baselines)
# =============================================================================

# Catalog and schema containing the Delta tables (aircraft, systems, sensors, sensor_readings)
LAKEHOUSE_CATALOG=""
LAKEHOUSE_SCHEMA="lakehouse"

# =============================================================================
# PostgreSQL Comparison (optional)
# =============================================================================

# PG credentials are read from deploy-lakebase/perftest-connection.json
# Run: cd deploy-lakebase && ./deploy.py refresh
# Only the JDBC JAR path (a Databricks Volume path) is configured here.
#PG_JDBC_JAR_PATH="/Volumes/<catalog>/<schema>/jars/postgresql-42.7.10.jar"
